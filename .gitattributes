# Normalise to LF in the repo; the runtime is Linux (WSL / Docker).
* text=auto eol=lf

# Never rewrite line endings for these
*.sh       text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf
*.ps1      text eol=crlf
.githooks/* text eol=lf

# Binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
