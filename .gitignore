# Agent runtime (generated only — kit assets under .agents/ ARE tracked)
.agents/env/python/.venv/
.agents/env/node/node_modules/

# Cursor junctions / generated hooks bridge (recreate via .agents/scripts/link-cursor.*)
.cursor/rules
.cursor/skills
.cursor/hooks
.cursor/hooks.json

