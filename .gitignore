node_modules/
dist/
build/
out/
target/
coverage/
*.log
*.tmp
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# TeX intermediates (generated PDFs live under out/, never committed)
